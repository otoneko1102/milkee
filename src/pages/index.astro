---
import Layout from "../layouts/Layout.astro";
import InstallBox from "../components/InstallBox.svelte";
import MilkeeStats from "../components/MilkeeStats.svelte";
import Warn from "../components/Warn.astro";
import { SITE_CONFIG } from "../settings/config.js";

// Runtime-only fetching: remove build-time network request so values are not baked into the build.
// The client script will fetch and populate the actual values when the page loads.

const stats = { version: "-", lastUpdated: "-", downloads: "-" };
const descLines = SITE_CONFIG.description.split(/\r\n|\r|\n|<br\s*\/?\>/g);
---

<Layout title="Home">
  <main class="home-hero">
    <a
      href={SITE_CONFIG.nav[2].href}
      target="_blank"
      rel="noreferrer"
      class="hero-npm-card"
    >
      <div class="hero-panel">
        <div class="hero-frame">
          <img src="/img/milkee-logo.png" alt="Milkee Logo" class="hero-logo" />
        </div>
      </div>
    </a>

    <h1 class="hero-title">{SITE_CONFIG.name}</h1>

    <p class="hero-subtitle">
      {
        descLines.map((line, i) => (
          <span>
            {line}
            {i < descLines.length - 1 ? <br /> : ""}
          </span>
        ))
      }
    </p>

    <MilkeeStats client:load />

    <Warn>
      <p>{SITE_CONFIG.messages.warnDeprecated}</p>
    </Warn>

    <InstallBox client:load />

    <div class="flex gap-3 flex-wrap justify-center">
      <a href="/docs" class="btn-primary">{SITE_CONFIG.buttons.getStarted}</a>
      <a href="/plugins" class="btn-secondary"
        >{SITE_CONFIG.buttons.findPlugins}</a
      >
    </div>

    <div class="mt-8">
      <a
        href={SITE_CONFIG.nav[2].href}
        target="_blank"
        rel="noreferrer"
        class="link-npm">{SITE_CONFIG.buttons.viewOnNpm}</a
      >
    </div>
  </main>
</Layout>
